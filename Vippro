--            SPEED HACK FUNCTIONALITY (CFRAME METHOD)                              --
--==================================================================================--

local speedHackEnabled = false
local speedValue = 10 -- Default speed
local minSpeed = 1   -- Base walkspeed approx
local maxSpeed = 30  -- Max slider speed

RunService.Heartbeat:Connect(function(deltaTime)
    if speedHackEnabled and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if humanoid and rootPart and humanoid.Health > 0 then
            local moveDir = humanoid.MoveDirection
            if moveDir.Magnitude > 0 then
                rootPart.CFrame = rootPart.CFrame + (moveDir * (speedValue * deltaTime))
            end
        end
    end
end)

--==================================================================================--
--            AUTO DIG FUNCTIONALITY                                                --
--==================================================================================--

local autoDigEnabled = false
local digDelay = 0.1 
local digRadius = 20 

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude
overlapParams.MaxParts = 99999 

local function findClosestBlock()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    overlapParams.FilterDescendantsInstances = {char}

    local parts = workspace:GetPartBoundsInRadius(root.Position, digRadius, overlapParams)

    local closestBlock = nil
    local shortestDistance = math.huge 

    for _, part in ipairs(parts) do
        if part.Parent and part.Parent.Name == "Blocks" and part:IsA("BasePart") then
            local dist = (root.Position - part.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                closestBlock = part
            end
        end
    end

    return closestBlock
end

local function digBlock(blockPosition)
    local event = ReplicatedStorage:FindFirstChild("ServerEvents")
    local digRemote = event and event:FindFirstChild("Dig")
    if digRemote then
        digRemote:FireServer(blockPosition)
    end
end

task.spawn(function()
    while task.wait(digDelay) do
        if autoDigEnabled then
            local target = findClosestBlock()
            if target then
                digBlock(target.Position)
            end
        end
    end
end)

