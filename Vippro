--==================================================================================--

local ESP_TEXT_SIZE = 20
local ESP_COLOR = Color3.new(1, 1, 1)
local espEnabled = true
local espTeamCheck = true

local espLabels = {}

local function getEspVisibility(player)
    if not espEnabled then return false end
    if espTeamCheck then
        if player.Team and player.Team == LocalPlayer.Team then
            return false
        end
    end
    return true
end

local function updateAllESPViz()
    for player, billboardGui in pairs(espLabels) do
        if billboardGui and billboardGui.Parent then
            billboardGui.Enabled = getEspVisibility(player)
            local infoLabel = billboardGui:FindFirstChild("ESPInfoText")
            if infoLabel then
                 local teamColor = player.Team and player.Team.TeamColor.Color or Color3.new(1, 1, 1)
                 infoLabel.TextColor3 = teamColor
            end
        end
    end
end

local function getFormattedText(character, username)
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoidRootPart then return username end

    local class = character:GetAttribute("Class")
    local class2 = character:GetAttribute("Class2")
    local size = character:GetAttribute("Size")

    local infoParts = {}
    if size then table.insert(infoParts, tostring(size)) end
    if class then table.insert(infoParts, tostring(class)) end
    if class2 then table.insert(infoParts, tostring(class2)) end

    local infoText = #infoParts > 0 and "(" .. table.concat(infoParts, " / ") .. ")" or ""
    return username .. " " .. infoText
end

local function createESP(player)
    if player == LocalPlayer then return end

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

    if espLabels[player] then
        espLabels[player]:Destroy()
        espLabels[player] = nil
    end

    local billboardGui = Instance.new("BillboardGui")
    billboardGui.Name = "ESP"
    billboardGui.Parent = humanoidRootPart
    billboardGui.Size = UDim2.new(0, 200, 0, 70) 
    billboardGui.StudsOffset = Vector3.new(0, 3, 0) 
    billboardGui.AlwaysOnTop = true

    local listLayout = Instance.new("UIListLayout")
    listLayout.Parent = billboardGui
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 5) 

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Name = "ESPInfoText"
    infoLabel.Parent = billboardGui
    infoLabel.LayoutOrder = 1 
    infoLabel.Size = UDim2.new(1, 0, 0, ESP_TEXT_SIZE)
    infoLabel.BackgroundTransparency = 1
    infoLabel.Text = getFormattedText(character, player.Name)
    infoLabel.TextColor3 = ESP_COLOR
    infoLabel.TextSize = ESP_TEXT_SIZE
    infoLabel.Font = Enum.Font.SourceSansBold
    infoLabel.TextStrokeTransparency = 0
    infoLabel.TextStrokeColor3 = Color3.new(0, 0, 0)

    local healthLabel = Instance.new("TextLabel")
    healthLabel.Name = "ESPHealthText"
    healthLabel.Parent = billboardGui
    healthLabel.LayoutOrder = 2 
    local healthTextSize = ESP_TEXT_SIZE - 2 
    healthLabel.Size = UDim2.new(1, 0, 0, healthTextSize)
    healthLabel.BackgroundTransparency = 1
    healthLabel.Text = "100 HP" 
    healthLabel.Font = Enum.Font.SourceSansBold
    healthLabel.TextSize = healthTextSize
    healthLabel.TextColor3 = Color3.fromRGB(85, 255, 85) 
    healthLabel.TextStrokeTransparency = 1 

    espLabels[player] = billboardGui

    local connections = {}

    local function updateHealthDisplay()
        if not humanoid or not healthLabel or not healthLabel.Parent then return end
        local health = humanoid.Health
        healthLabel.Text = math.floor(health) .. " HP"
        if health > 50 then
            healthLabel.TextColor3 = Color3.fromRGB(85, 255, 85)
        else
            healthLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
        end
    end

    local function updateColorAndViz()
        local teamColor = player.Team and player.Team.TeamColor.Color or Color3.new(1, 1, 1)
        infoLabel.TextColor3 = teamColor
        billboardGui.Enabled = getEspVisibility(player)
    end

    local function connectAttributeChange(attrName)
        if character.GetAttributeChangedSignal then
            table.insert(connections, character:GetAttributeChangedSignal(attrName):Connect(function()
                if infoLabel and infoLabel.Parent then
                    infoLabel.Text = getFormattedText(character, player.Name)
                end
            end))
        end
    end
    connectAttributeChange("Class")
    connectAttributeChange("Class2")
    connectAttributeChange("Size")

    table.insert(connections, player:GetPropertyChangedSignal("Team"):Connect(updateColorAndViz))
    table.insert(connections, humanoid.HealthChanged:Connect(updateHealthDisplay))

    updateColorAndViz()
    updateHealthDisplay()

    local respawnConnection
    respawnConnection = player.CharacterAdded:Connect(function(newCharacter)
        if billboardGui then billboardGui:Destroy() end
        for _, conn in ipairs(connections) do conn:Disconnect() end
        if espLabels[player] then espLabels[player] = nil end
        if respawnConnection then respawnConnection:Disconnect() end
        task.wait(0.1)
        createESP(player)
    end)

    local leaveConnection
    leaveConnection = player.AncestryChanged:Connect(function()
        if not player.Parent then
            if billboardGui then billboardGui:Destroy() end
            for _, conn in ipairs(connections) do conn:Disconnect() end
            if respawnConnection then respawnConnection:Disconnect() end
            if leaveConnection then leaveConnection:Disconnect() end
            espLabels[player] = nil
        end
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer and player.Character then
        spawn(function() createESP(player) end)
    end
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function() createESP(player) end)
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function() createESP(player) end)
    end
end)

LocalPlayer:GetPropertyChangedSignal("Team"):Connect(updateAllESPViz)

